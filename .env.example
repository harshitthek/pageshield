# Page Shield — Configuration Template
# Set your API keys here or directly in background.js / chrome.storage.local

# Default AI Provider: "groq" or "gemini"
PROVIDER=groq

# Groq API Key (Get a free key from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (Get a free key from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
